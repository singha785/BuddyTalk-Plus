# ── BuddyTalk+ API Server — environment variables ──────────────────────────
# Copy this file to .env and fill in real values before running locally.

# Server port (required)
PORT=8080

# Node environment: development | production
NODE_ENV=development

# PostgreSQL connection string (required)
# Local:    postgresql://buddytalk:buddytalk@localhost:5432/buddytalk
# Supabase: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Neon:     postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://buddytalk:buddytalk@localhost:5432/buddytalk

# CORS allowed origins in production (comma-separated).
# In development (NODE_ENV=development) all origins are allowed automatically.
# Example: https://your-app.com,https://www.your-app.com
ALLOWED_ORIGINS=
